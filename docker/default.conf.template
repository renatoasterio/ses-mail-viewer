# Processado pelo envsubst da imagem oficial do nginx.
# ${NGINX_LOCAL_RESOLVERS} vem do /etc/resolv.conf do container: o host do
# LocalStack é resolvido a cada requisição, então o visualizador sobe mesmo
# antes do LocalStack existir.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen ${PORT};
    root /usr/share/nginx/html;

    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"localstackEndpoint":"${LOCALSTACK_ENDPOINT}"}';
    }

    # Mesmo contrato do proxy do Vite: /localstack/* -> LocalStack.
    location /localstack/ {
        set $localstack_upstream "${LOCALSTACK_ENDPOINT}";
        rewrite ^/localstack/(.*)$ /$1 break;
        proxy_pass $localstack_upstream;
        # O LocalStack rejeita (403) Origin fora da lista de CORS.
        proxy_set_header Origin "";
        proxy_set_header Referer "";
        proxy_read_timeout 60s;
        client_max_body_size 50m;
    }

    location / {
        try_files $uri /index.html;
    }
}
